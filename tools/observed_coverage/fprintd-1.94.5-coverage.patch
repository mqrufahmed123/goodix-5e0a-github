+static gboolean
+fprint_device_get_enrollment_coverage (FprintDBusDevice      *dbus_dev,
+                                       GDBusMethodInvocation *invocation)
+{
+  FprintDevice *rdev = FPRINT_DEVICE (dbus_dev);
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  g_autoptr(GError) error = NULL;
+  GVariant *coverage;
+
+  if (!_fprint_device_check_claimed (rdev, invocation, &error))
+    {
+      g_dbus_method_invocation_return_gerror (invocation, error);
+      return TRUE;
+    }
+
+  coverage = g_object_get_data (G_OBJECT (priv->dev), "goodix-5e0a-coverage-v1");
+  if (coverage && g_variant_is_of_type (coverage, G_VARIANT_TYPE_VARDICT))
+    fprint_dbus_device_complete_get_enrollment_coverage (dbus_dev, invocation, coverage);
+  else
+    {
+      GVariantBuilder builder;
+      g_variant_builder_init (&builder, G_VARIANT_TYPE_VARDICT);
+      fprint_dbus_device_complete_get_enrollment_coverage (dbus_dev, invocation,
+                                                          g_variant_builder_end (&builder));
+    }
+  return TRUE;
+}
