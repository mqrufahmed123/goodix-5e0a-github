+/* Coverage is an optional claim-owner-only extension. It conveys only a
+ * coarse registered occupancy map; it never exposes captured ridge images. */
+typedef struct
+{
+  CcFingerprintDialog *dialog;
+  guint generation;
+} CoverageRequest;
+
+static gboolean coverage_poll (gpointer user_data);
+
+static void
+coverage_stop (CcFingerprintDialog *self)
+{
+  self->coverage_generation++;
+  self->coverage_active = self->coverage_pending = FALSE;
+  g_clear_handle_id (&self->coverage_poll_id, g_source_remove);
+  if (self->coverage_cancellable)
+    g_cancellable_cancel (self->coverage_cancellable);
+  g_clear_object (&self->coverage_cancellable);
+}
+
+static gboolean
+coverage_apply_reply (CcFingerprintDialog *self, GVariant *coverage, guint generation)
+{
+  guint64 session;
+  if (generation != self->coverage_generation || !self->coverage_active ||
+      !g_variant_lookup (coverage, "session", "t", &session) ||
+      session <= self->coverage_previous_session)
+    return FALSE;
+  if (!cc_fingerprint_guide_apply_coverage (self->enroll_guide, coverage))
+    return FALSE;
+  self->coverage_last_session = session;
+  return TRUE;
+}
+
+static void
+coverage_ready (GObject *object, GAsyncResult *result, gpointer user_data)
+{
+  CoverageRequest *request = user_data;
+  g_autoptr(CcFingerprintDialog) self = request->dialog;
+  guint generation = request->generation;
+  g_autoptr(GError) error = NULL;
+  g_autoptr(GVariant) reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (object), result, &error);
+  g_free (request);
+  if (generation != self->coverage_generation || !self->coverage_active ||
+      object != G_OBJECT (self->device))
+    return;
+  self->coverage_pending = FALSE;
+  if (error)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        cc_fingerprint_guide_set_coverage_unavailable (self->enroll_guide);
+      coverage_stop (self);
+      return;
+    }
+  if (!g_variant_is_of_type (reply, G_VARIANT_TYPE ("(a{sv})")))
+    {
+      cc_fingerprint_guide_set_coverage_unavailable (self->enroll_guide);
+      coverage_stop (self);
+      return;
+    }
+  g_autoptr(GVariant) coverage = g_variant_get_child_value (reply, 0);
+  if (!coverage_apply_reply (self, coverage, generation))
+    {
+      /* A previous enrollment snapshot can briefly be visible while the new
+       * operation starts. Never draw it in the current enrollment. */
+      if (self->coverage_final && ++self->coverage_final_attempts >= 5)
+        coverage_stop (self);
+      return;
+    }
+  guint frame = 0;
+  g_variant_lookup (coverage, "frame", "u", &frame);
+  if (self->coverage_final && (frame >= 12 || ++self->coverage_final_attempts >= 5))
+    coverage_stop (self);
+}
+
+static gboolean
+coverage_poll (gpointer user_data)
+{
+  CcFingerprintDialog *self = user_data;
+  CoverageRequest *request;
+  if (!self->coverage_active)
+    return G_SOURCE_REMOVE;
+  if (self->coverage_pending)
+    return G_SOURCE_CONTINUE;
+  request = g_new0 (CoverageRequest, 1);
+  request->dialog = g_object_ref (self);
+  request->generation = self->coverage_generation;
+  self->coverage_pending = TRUE;
+  g_dbus_proxy_call (G_DBUS_PROXY (self->device), "GetEnrollmentCoverage", NULL,
+                    G_DBUS_CALL_FLAGS_NONE, 2000, self->coverage_cancellable,
+                    coverage_ready, request);
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+coverage_start (CcFingerprintDialog *self)
+{
+  if (self->coverage_active || !self->coverage_start_ready ||
+      !gtk_widget_get_mapped (GTK_WIDGET (self->enroll_guide)) ||
+      !gtk_widget_get_visible (GTK_WIDGET (self->enroll_guide)))
+    return;
+  if (!G_IS_DBUS_PROXY (self->device))
+    {
+      cc_fingerprint_guide_set_coverage_unavailable (self->enroll_guide);
+      return;
+    }
+  self->coverage_active = TRUE;
+  self->coverage_cancellable = g_cancellable_new ();
+  self->coverage_poll_id = g_timeout_add (200, coverage_poll, self);
+  coverage_poll (self);
+}
+
+static void
+coverage_guide_mapped (GtkWidget *widget, CcFingerprintDialog *self)
+{
+  coverage_start (self);
+}
+
+static void
+coverage_guide_unmapped (GtkWidget *widget, CcFingerprintDialog *self)
+{
+  coverage_stop (self);
+}
+
+static void
+update_enroll_guide (CcFingerprintDialog *self,
+                     gboolean             completed,
+                     gboolean             failed,
+                     gboolean             retry)
+{
+  guint stages, offset, accepted;
+
+  if (!gtk_widget_get_visible (GTK_WIDGET (self->enroll_guide)))
+    return;
+
+  stages = cc_fprintd_device_get_num_enroll_stages (self->device);
+  /* fprintd adds an initial identification stage when duplicate checking is
+   * supported. That impression is not added to the enrollment template. */
+  offset = stages == 13 ? 1 : 0;
+  accepted = self->enroll_stages_passed;
+
+  if (offset && accepted == 0 && !completed && !failed)
+    cc_fingerprint_guide_set_checking (self->enroll_guide, retry);
+  else
+    cc_fingerprint_guide_set_state (self->enroll_guide,
+                                     accepted > offset ? accepted - offset : 0,
+                                     12, completed, failed, retry);
+}
